  m_EditorClassIdentifier: 
  noteText: "\uB178\uC778\uC740 \uB9D0\uD558\uAE38, \"\uC774 \uAD6C\uC2AC\uC740 \uD53C
    \uC18D\uC5D0 \uC228\uACA8\uC9C4 \uD608\uD1B5\uC758 \uAC00\uCE58\uB97C \uB4DC\uB7EC\uB0B4\uB294
    \uC2E0\uBB3C\uC774\uB77C\uC624. \uAC00\uBB38 \uB300\uB300\uB85C \uC774\uC5B4\uC838\uC57C
    \uD560 **'\uC88B\uC740 \uD608\uD1B5'**\uC758 \uC99D\uD45C\uB85C, \uADF8 \uD53C\uB97C
    \uB9CC\uB098\uBA74 \uD658\uD55C \uBE5B\uC744 \uD130\uB728\uB9B4 \uAC83\uC774\uC624.
    \uD5C8\uB098 \uADF8\uC5D0 \uBBF8\uCE58\uC9C0 \uBABB\uD558\uB294 \uD53C \uC55E\uC5D0\uC11C\uB294
    \uB0C9\uC815\uD788 \uCE68\uBB35\uD560 \uBFD0\uC774\uB2C8, \uC774\uB85C\uC368
    \uC624\uC9C1 \uC88B\uC740 \uD608\uD1B5\uB9CC\uC744 \uAC00\uB824\uB0B4\uC5B4 \uAC00\uBB38\uC758
    \uC55E\uB0A0\uC744 \uBC1D\uD788\uC2DC\uC624.\""
