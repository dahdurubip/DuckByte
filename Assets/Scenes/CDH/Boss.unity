  m_Script: {fileID: 11500000, guid: 45877cebf0dd83f49850cf80ca27b471, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "\uBB34\uC624\uB144 \uAE4A\uC740 \uACA8\uC6B8\n\uC694\uC0AC\uC774 '\uC815\uD654\uC758
    \uBC29' \uADFC\uCC98\uC5D0\uC11C \uBC24\uB9C8\uB2E4 \uACE1\uC18C\uB9AC\uAC00
    \uC7A6\uB2E4\uB294 \uBCF4\uACE0\uAC00 \uC2EC\uC2EC\uCC2E\uAC8C \uC62C\uB77C\uC628\uB2E4.
    \uD544\uC2DC \uC815\uD654\uB418\uC9C0 \uBABB\uD55C \uC6D0\uADC0\uB4E4\uC758 \uB9C8\uC9C0\uB9C9
    \uBC1C\uC545\uC774\uB9AC\uB77C. \uB354\uC6B1 \uCCA0\uC800\uD788 \uB2E8\uC18D\uD558\uACE0,
    \uC81C\uB97C \uC62C\uB824 \uADF8 \uC0AC\uC545\uD55C \uAE30\uC6B4\uC744 \uB20C\uB7EC\uC57C\uACA0\uB2E4.
    \uC6B0\uB9AC \uAC00\uBB38\uC758 \uB300\uC5C5\uC740 \uC774\uB7F0 \uC0AC\uC18C\uD55C
    \uBC29\uD574\uC5D0 \uACB0\uCF54 \uD754\uB4E4\uB824\uC11C\uB294 \uC544\uB2C8 \uB41C\uB2E4."
