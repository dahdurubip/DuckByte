  m_Script: {fileID: 11500000, guid: 45877cebf0dd83f49850cf80ca27b471, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "\uC190\uC5D0 \uC954 \uAD6C\uC2AC\uC740 \uC5EC\uC804\uD788 \uAE30\uBB18\uD55C
    \uC628\uAE30\uB97C \uD488\uACE0 \uBBF8\uC138\uD558\uAC8C \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4.
    \uB178\uC778\uC758 \uB9D0\uC774 \uC0AC\uC2E4\uC774\uB77C\uBA74, \uC774 \uAD6C\uC2AC\uC774\uC57C\uB9D0\uB85C
    \uD558\uB298\uC774 \uC6B0\uB9AC \uAC00\uBB38\uC5D0 \uB0B4\uB9B0 \uCC9C\uAE08\uAC19\uC740
    \uAE30\uD68C\uAC00 \uC544\uB2CC\uAC00! \uC774\uC81C \uB354\uB294 \uD608\uD1B5\uC5D0
    \uB300\uD55C \uB9C9\uC5F0\uD55C \uBD88\uC548\uAC10\uACFC \uB05D\uC5C6\uB294 \uC758\uC2EC\uC5D0
    \uBC24\uC7A0 \uC124\uCE58\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB9AC\uB77C. \uC774
    \uAD6C\uC2AC\uC774 \uC9C1\uC811 '\uC88B\uC740 \uD608\uD1B5'\uC744 \uBA85\uBA85\uBC31\uBC31\uD788
    \uC99D\uBA85\uD574 \uC904 \uAC83\uC774\uB2C8!"
