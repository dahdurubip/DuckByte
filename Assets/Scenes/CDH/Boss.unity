  m_Script: {fileID: 11500000, guid: 45877cebf0dd83f49850cf80ca27b471, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "\uACBD\uC2E0\uB144 \uB3D9\uD2C0 \uBB34\uB835\r\n\uC774 \uAC00\uBB38\uC744
    \uC774\uB04C\uACE0 \uD608\uD1B5\uC744 \uBCF4\uC874\uD558\uB294 \uAC83\uC740 \uB098\uC758
    \uC219\uBA85\uC774\uC790 \uC2E0\uC131\uD55C \uC758\uBB34\uC774\uB2E4. \uADF8
    \uACFC\uC815\uC5D0 \uC218\uB9CE\uC740 \uD76C\uC0DD\uACFC \uACE0\uD1B5\uC774 \uB530\uB978\uB2E4
    \uD560\uC9C0\uB77C\uB3C4, \uC774\uB294 \uBAA8\uB450 \uC6B0\uB9AC \uAC00\uBB38\uC758
    \uCC2C\uB780\uD55C \uBBF8\uB798\uB97C \uC704\uD55C \uAC70\uB984\uC77C \uBFD0\uC774\uB2E4.
    \uB354\uC6B1 \uC21C\uC218\uD558\uACE0 \uB354\uC6B1 \uAC15\uC778\uD55C \uD6C4\uC190\uB4E4\uC774
    \uC774 \uB545\uC744 \uD638\uB839\uD560 \uADF8\uB0A0\uAE4C\uC9C0, \uB098\uC758
    \uC5ED\uD560\uC740 \uB05D\uB098\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4.\r"
