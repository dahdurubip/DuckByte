  m_Name: 
  m_EditorClassIdentifier: 
  noteText: "\uC5EC\uAE30\uAE4C\uC9C0 \uC640\uBCF4\uB2C8 \uC774\uC81C \uB0B4 \uBAB8\uC774
    \uB354 \uC774\uC0C1 \uB0B4 \uAC83\uC774 \uC544\uB2CC \uAC83 \uAC19\uB2E4.\n\uAC00\uB054\uC740
    \uB208\uC55E\uC5D0 \uD658\uAC01\uC774 \uB5A0\uB3CC\uACE0, \uC815\uC2E0\uC774
    \uC5B4\uB514\uC5D0 \uC788\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4.\n\uB098\uB294\u2026
    \uACFC\uC5F0 \uC5EC\uAE30\uC11C \uD0C8\uCD9C\uD560 \uC218 \uC788\uC744\uAE4C.\n\uC774\uAC8C
    \uBC14\uB85C \uAC00\uBB38\uC758 \uC800\uC8FC\uC778\uAC00..\n\uD639\uC2DC\uB77C\uB3C4
    \uB124\uAC00 \uB098\uAC08 \uC218 \uC788\uB2E4\uBA74, \uC81C\uBC1C \uC804\uD574\uC918.\n\uC774
    \uC9D1\uC5D0 \uD568\uBD80\uB85C \uB4E4\uC5B4\uC624\uBA74 \uC548 \uB41C\uB2E4\uACE0\u2026
    \uB204\uAD6C\uB3C4, \uB2E4\uC2DC\uB294."
