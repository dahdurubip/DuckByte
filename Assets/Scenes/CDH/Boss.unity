  m_Script: {fileID: 11500000, guid: 45877cebf0dd83f49850cf80ca27b471, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteText: " \uAC11\uC778\uB144 \uCD08\uBD04\r\n\uC5B4\uB290\uB367 \uB0B4 \uC544\uB4E4\uB3C4
    \uC800\uC8FC\uAC00 \uBC1C\uD604\uB420 \uB098\uC774\uAC00 \uAC00\uAE4C\uC6CC \uC624\uB294\uAD6C\uB098.
    \uB140\uC11D\uC758 \uB208\uBE5B\uC774 \uC544\uC9C1\uC740 \uCD1D\uBA85\uD558\uB2C8,
    \uD544\uC2DC \uC774 \uC2DC\uB828\uC744 \uC798 \uB118\uAE30\uB9AC\uB77C \uBBFF\uB294\uB2E4.
    \uC124\uB839 \uC721\uC2E0\uC758 \uB208\uACFC \uADC0\uAC00 \uADF8 \uAE30\uB2A5\uC744
    \uB2E4\uD55C\uB4E4, \uAC00\uBB38\uC758 \uC601\uAD11\uC744 \uBCF4\uACE0 \uC120\uC870\uC758
    \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218 \uC788\uB294 \uC2EC\uC548(\u5FC3\u773C)\uACFC
    \uC2EC\uC774(\u5FC3\u8033)\uB9CC \uB728\uC778\uB2E4\uBA74 \uADF8\uAC83\uC73C\uB85C
    \uC871\uD558\uB2E4. \uBD80\uB514 \uAC15\uC778\uD568\uC744 \uC99D\uBA85\uD558\uAC70\uB77C."
