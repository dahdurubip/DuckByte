<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.unionavatars.sdk/Editor/UXML/UnionAvatars_Editor.uss?fileID=7433441132597879392&amp;guid=82fa1b865a2135442a5cfdee6a5a5bc8&amp;type=3#UnionAvatars_Editor" />
    <ui:VisualElement name="LoginPanel" style="flex-grow: 1; display: flex; -unity-background-scale-mode: stretch-to-fill;">
        <ui:Label text="Welcome to the Union Avatars SDK!" display-tooltip-when-elided="true" name="WelcomeText" style="-unity-text-align: upper-center; font-size: 20px; -unity-font-style: bold; margin-top: 21px;" />
        <ui:VisualElement name="LoggedIn" style="height: auto; align-items: center; visibility: visible; display: none;">
            <ui:Label text="Active user:\n name@mail.com" display-tooltip-when-elided="true" name="Logged" style="-unity-text-align: middle-center; font-size: 18px; -unity-font-style: normal; margin-top: 21px; flex-grow: 0; margin-bottom: 0; height: 73px; display: flex;" />
            <ui:Button text="Generate API key" display-tooltip-when-elided="true" name="generate-key-button" focusable="true" style="flex-basis: auto; width: auto; font-size: 18px; justify-content: space-around; align-items: stretch; padding-left: 16px; padding-right: 16px; padding-top: 4px; padding-bottom: 4px; opacity: 1; visibility: visible; display: flex;" />
            <ui:Label text="API Key generated:\n&lt;size=12&gt;Copy it and save it somewhere&lt;/size&gt;\n\n&lt;size=10&gt;asdasdwasdwasdwawda\nExpires: 10-20-39&lt;/size&gt;" display-tooltip-when-elided="true" name="api-key" style="-unity-text-align: upper-center; font-size: 15px; margin-top: 30px; margin-bottom: 30px; display: none;" />
            <ui:Button text="Log out" display-tooltip-when-elided="true" name="logout-button" style="flex-basis: auto; width: auto; font-size: 18px; justify-content: space-around; align-items: stretch; padding-left: 16px; padding-right: 16px; padding-top: 4px; padding-bottom: 4px;" />
        </ui:VisualElement>
        <ui:VisualElement name="LogIn" style="height: auto; align-items: center; visibility: visible; display: flex;">
            <ui:Label text="Enter your developer credentials:" display-tooltip-when-elided="true" name="Logged" style="-unity-text-align: middle-center; font-size: 18px; -unity-font-style: normal; margin-top: 21px; flex-grow: 0; margin-bottom: 0; height: 47px;" />
            <ui:TextField picking-mode="Ignore" label="Username" name="username-field" style="font-size: 16px; flex-shrink: 0; flex-grow: 1; width: 80%; justify-content: flex-start; align-items: stretch; transform-origin: center;" />
            <ui:TextField picking-mode="Ignore" label="Password" name="password-field" style="font-size: 16px; flex-shrink: 0; flex-grow: 1; width: 80%; justify-content: flex-start; align-items: stretch; transform-origin: center;" />
            <ui:TextField picking-mode="Ignore" label="Organization" name="organization-field" style="font-size: 16px; flex-shrink: 0; flex-grow: 1; width: 80%; justify-content: flex-start; align-items: stretch; transform-origin: center;" />
            <ui:Button text="Log in" display-tooltip-when-elided="true" name="login-button" style="flex-basis: auto; width: auto; font-size: 18px; justify-content: space-around; align-items: stretch; padding-left: 16px; padding-right: 16px; padding-top: 4px; padding-bottom: 4px; margin-top: 12px;" />
        </ui:VisualElement>
        <ui:VisualElement style="background-color: rgb(84, 84, 84); height: 48px; padding-top: 0; padding-right: 20px; padding-bottom: 0; padding-left: 20px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; justify-content: center; flex-direction: row;">
            <ui:Label text="You don&apos;t have developer credentials? " display-tooltip-when-elided="true" style="-unity-text-align: middle-left;" />
            <ui:Button text="Press here!" display-tooltip-when-elided="true" name="GetCredentials" style="margin-top: 6px; margin-bottom: 6px; padding-left: 8px; padding-right: 8px; font-size: 12px; background-color: rgba(88, 88, 88, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-style: bold; overflow: hidden; transition-duration: 0.2;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
