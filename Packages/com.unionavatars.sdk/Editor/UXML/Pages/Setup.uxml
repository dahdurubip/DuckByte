<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.unionavatars.sdk/Editor/UXML/UnionAvatars_Editor.uss?fileID=7433441132597879392&amp;guid=82fa1b865a2135442a5cfdee6a5a5bc8&amp;type=3#UnionAvatars_Editor" />
    <ui:VisualElement name="SettingsPanel" style="flex-grow: 1; align-items: center; padding-top: 25px; -unity-text-align: upper-left; padding-right: 0; display: flex;">
        <ui:VisualElement name="Header" style="flex-direction: row; justify-content: space-between; width: 90%; padding-right: 10px; padding-left: 10px; margin-bottom: 8px; background-color: rgb(38, 38, 38); padding-top: 10px; padding-bottom: 10px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;">
            <ui:Label text="Requirements" display-tooltip-when-elided="true" name="Title" style="font-size: 13px; -unity-text-align: upper-center; -unity-font-style: bold; justify-content: flex-start;" />
            <ui:Label text="Status" display-tooltip-when-elided="true" name="Done" style="font-size: 13px; -unity-font-style: bold; color: rgb(210, 210, 210); -unity-text-align: upper-center;" />
        </ui:VisualElement>
        <ui:VisualElement name="Layer" class="option-container">
            <ui:Label text="Create a layer called &quot;Avatar&quot;" display-tooltip-when-elided="true" name="Title" style="font-size: 13px;" />
            <ui:Label text="Pending" display-tooltip-when-elided="true" name="Done" style="font-size: 14px; -unity-font-style: bold; color: rgb(233, 56, 56);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
