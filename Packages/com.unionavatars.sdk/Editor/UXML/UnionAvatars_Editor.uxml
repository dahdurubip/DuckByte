<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.unionavatars.sdk/Editor/UXML/UnionAvatars_Editor.uss?fileID=7433441132597879392&amp;guid=82fa1b865a2135442a5cfdee6a5a5bc8&amp;type=3#UnionAvatars_Editor" />
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="HeaderImage" style="background-image: url(&apos;project://database/Packages/com.unionavatars.sdk/Editor/Images/UnionAvatars_Banner.png?fileID=2800000&amp;guid=08f941865671668419ac5d1d130ac7c0&amp;type=3#UnionAvatars_Banner&apos;); width: 100%; height: 38%; -unity-background-scale-mode: scale-and-crop; margin-top: 0; justify-content: space-around; align-items: stretch; max-height: 190px;" />
        <uie:Toolbar name="navbar" style="flex-shrink: 1; height: 41px; border-bottom-width: 0; overflow: visible; align-items: stretch; justify-content: flex-start; margin-left: 2px; margin-right: 2px; margin-top: 8px; margin-bottom: 6px; display: none;">
            <uie:ToolbarButton text="Login" display-tooltip-when-elided="true" name="nav-login" class="nav-button" />
            <uie:ToolbarButton text="Setup" display-tooltip-when-elided="true" name="nav-setup" class="nav-button" />
            <uie:ToolbarButton text="Settings" display-tooltip-when-elided="true" name="nav-settings" class="nav-button" />
            <uie:ToolbarButton text="Documentation" display-tooltip-when-elided="true" name="nav-docs" class="nav-button" />
        </uie:Toolbar>
        <ui:VisualElement name="Container" style="flex-grow: 1;" />
        <ui:VisualElement name="SocialMedia" style="position: absolute; bottom: 0; right: 0; padding-bottom: 10px; padding-left: 0; flex-direction: row-reverse; padding-right: 4px;">
            <ui:Button display-tooltip-when-elided="false" enable-rich-text="false" name="discord" class="social-media" style="background-image: url(&apos;project://database/Packages/com.unionavatars.sdk/Editor/Images/discord-icon.png?fileID=2800000&amp;guid=bad595752da186c4b9e84e4079962dc9&amp;type=3#discord-icon&apos;);" />
            <ui:Button display-tooltip-when-elided="false" enable-rich-text="false" name="twitter" class="social-media" style="background-image: url(&apos;project://database/Packages/com.unionavatars.sdk/Editor/Images/twitter-icon.png?fileID=2800000&amp;guid=48043a57f074a3243b663a95ef07ab1c&amp;type=3#twitter-icon&apos;);" />
            <ui:Button display-tooltip-when-elided="false" enable-rich-text="false" name="website" class="social-media" style="background-image: url(&apos;project://database/Packages/com.unionavatars.sdk/Editor/Images/web-icon.png?fileID=2800000&amp;guid=c27a9f8185901494186fc7c87dd404b1&amp;type=3#web-icon&apos;);" />
        </ui:VisualElement>
        <ui:Label text="v 1.5.0" display-tooltip-when-elided="true" name="Version" style="-unity-text-align: upper-left; font-size: 11px; -unity-font-style: bold; margin-top: 0; color: rgb(255, 255, 255); padding-left: 11px; padding-bottom: 6px; position: absolute; bottom: 18px; left: 0;" />
        <ui:VisualElement style="position: absolute; bottom: 3px; left: 0; flex-direction: row; padding-right: 0; padding-bottom: 0;">
            <ui:Button text="Privacy Policy" display-tooltip-when-elided="true" name="privacy-policy" style="background-color: rgba(88, 88, 88, 0); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); font-size: 12px;" />
            <ui:Button text="Cookie  Policy" display-tooltip-when-elided="true" name="cookie-policy" style="background-color: rgba(88, 88, 88, 0); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); font-size: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
